# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://sameem:sameem@localhost:5432/sameem_hub?schema=public

# Redis (sessions, cache, pub/sub)
REDIS_URL=redis://localhost:6379

# JWT secrets — generate 256-bit random values for production
JWT_SECRET=replace-with-256-bit-random
JWT_REFRESH_SECRET=replace-with-different-256-bit-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# S3 (use MinIO locally, AWS S3 in production — me-south-1 for KSA)
S3_ENDPOINT=http://localhost:9000
S3_REGION=me-south-1
S3_BUCKET=sameem-hub-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email (SES in prod, MailHog locally)
EMAIL_PROVIDER=ses
EMAIL_FROM=no-reply@sameem.hub
SES_REGION=me-south-1

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Logging
LOG_LEVEL=info

# Rate limits
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_MUTATION_PER_MIN=60

# Phase 2 integrations (feature-flagged)
ZATCA_API_KEY=
ZATCA_BASE_URL=https://gw-fatoora.zatca.gov.sa
