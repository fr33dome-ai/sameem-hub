{
  "name": "sameem-hub-backend",
  "version": "1.4.0",
  "private": true,
  "description": "Sameem Hub — REST API (Express + Prisma + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:integration": "vitest --config vitest.integration.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "express": "^4.21.0",
    "@prisma/client": "^5.20.0",
    "zod": "^3.23.0",
    "jsonwebtoken": "^9.0.0",
    "bcrypt": "^5.1.0",
    "argon2": "^0.40.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.3.0",
    "ioredis": "^5.4.0",
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "pino": "^9.3.0",
    "pino-http": "^10.2.0",
    "dotenv": "^16.4.0",
    "uuid": "^10.0.0",
    "@sentry/node": "^8.20.0",
    "date-fns": "^3.6.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.16.0",
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "vitest": "^2.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "prisma": "^5.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
