{
  "name": "sameem-hub-backend",
  "version": "1.8.0",
  "private": true,
  "description": "Sameem Hub — REST API (Express + Prisma + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "//deps": "Only packages actually imported by src/ are listed. Native modules (argon2, bcrypt, ioredis, aws-sdk) were removed — they need a compile step that fails on Netlify's build image and were unused or replaceable.",
  "dependencies": {
    "express": "^4.21.0",
    "@prisma/client": "^5.20.0",
    "zod": "^3.23.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.3.0",
    "pino": "^9.3.0",
    "pino-http": "^10.2.0",
    "dotenv": "^16.4.0",
    "date-fns": "^3.6.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.16.0",
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.0",
    "prisma": "^5.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
