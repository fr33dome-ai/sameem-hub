# =============================================================================
# Sameem Hub — production environment variables (Netlify)
# =============================================================================
# Set these in:  Netlify Dashboard → Site settings → Environment variables
# DO NOT commit a real .env.production file. This file is the template only.
# =============================================================================

# ----- Database (external Postgres) -----
# Recommended providers (free tiers available):
#   • Neon         https://neon.tech              (eu-central-1 closest to KSA)
#   • Supabase     https://supabase.com           (ap-south-1 / eu-central-1)
#   • Railway      https://railway.app            (us-west / eu-west)
# For PDPL compliance, choose the region nearest KSA or add a KSA read-replica.
DATABASE_URL=postgresql://USER:PASS@HOST.neon.tech/sameem_hub?sslmode=require

# ----- Auth -----
JWT_SECRET=replace-with-64-random-hex-chars
JWT_REFRESH_SECRET=replace-with-another-64-random-hex-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ----- Application URLs -----
# Comma-separated list — used for CORS allow-list
APP_URL=https://sameem-hub.netlify.app,https://app.sameemhub.sa
NEXT_PUBLIC_API_URL=/api

# ----- Object storage (S3-compatible) -----
# For file uploads — works with AWS S3, Cloudflare R2, Backblaze B2
S3_REGION=me-south-1
S3_BUCKET=sameem-hub-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ----- Redis (rate limiting + sessions) -----
# Recommended: Upstash (https://upstash.com) — globally distributed, REST-friendly
REDIS_URL=rediss://default:PASS@HOST.upstash.io:6379

# ----- Observability -----
SENTRY_DSN=
LOG_LEVEL=info

# ----- Saudi-first compliance flags -----
ZATCA_API_BASE=https://gw-fatoora.zatca.gov.sa
ZATCA_CERT_PATH=
ZATCA_VAT_NUMBER=
PDPL_DATA_RESIDENCY=me-south-1
SASO_PRODUCT_REGISTRY_API=
