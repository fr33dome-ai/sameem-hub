# =============================================================================
# Sameem Hub — production environment variables (v1.8)
# =============================================================================
# Set these in: Netlify → Site settings → Environment variables
# Never commit a real .env file. This is the template only.
# =============================================================================

# ----- Database (REQUIRED for cloud sync) -----
# Neon is recommended: https://neon.tech — free tier, no card.
# Pick the region closest to KSA (AWS eu-central-1 / Frankfurt).
# Use the POOLED connection string (it has "-pooler" in the host).
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ----- Cloud sync (REQUIRED) -----
# Shared secret the dashboard sends in the x-sameem-key header.
# Generate with:  openssl rand -base64 32
# This is what you paste into the dashboard's Cloud Sync panel.
SYNC_SECRET=replace-with-a-long-random-string

# Which workspace row to read/write. One workspace = one row.
WORKSPACE_KEY=sameem-main

# ----- Application URLs -----
# Comma-separated CORS allow-list.
APP_URL=https://sameem-hub.netlify.app
NEXT_PUBLIC_API_URL=/api

# =============================================================================
# NOT NEEDED YET — leave unset until the features that use them are built.
# Setting empty values here would only create confusion.
# =============================================================================

# ----- Auth (Phase 2: real user accounts) -----
# The /v1/auth routes exist but nothing calls them yet. Cloud sync uses the
# shared secret above instead.
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d

# ----- Object storage (Phase 2: file uploads) -----
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ----- Redis (Phase 2: distributed rate limiting) -----
# Rate limiting currently runs in-memory, which is fine for one user.
# REDIS_URL=

# ----- Saudi compliance (Phase 3: when handling customer data/invoices) -----
# Deliberately deferred. These matter once you process other companies'
# invoices and personal data — not while running your own numbers.
# ZATCA_API_BASE=https://gw-fatoora.zatca.gov.sa
# ZATCA_CERT_PATH=
# ZATCA_VAT_NUMBER=
# PDPL_DATA_RESIDENCY=me-south-1

# ----- Observability -----
# SENTRY_DSN=
LOG_LEVEL=info
